# Frontend (aman publik). Isi di Cloudflare Pages > Settings > Environment variables.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Edge Functions (set lewat `supabase secrets set`, JANGAN di GitHub / Cloudflare frontend)
# SUPABASE_SERVICE_ROLE_KEY=   (otomatis tersedia di Edge Functions)
# STORE_BASE_URL=https://nama-proyek.pages.dev
# ORDER_TOKEN_PEPPER=          (acak panjang: openssl rand -hex 32)
# ENCRYPTION_KEY=              (belum dipakai; untuk stok digital nanti)
